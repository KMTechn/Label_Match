{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kmtech.local/factory/v1/coinstall-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_schema_version", "corrective_revision", "default_policy", "pairs", "integrated_workflows"],
  "properties": {
    "matrix_schema_version": {"const": 2},
    "corrective_revision": {"const": 1},
    "default_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_mode", "status", "reason_code"],
      "properties": {
        "workflow_mode": {"const": "independent"},
        "status": {"const": "blocked"},
        "reason_code": {"const": "ROLE_PC_SEPARATION_REQUIRED"}
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apps", "reason_code", "shared_resources", "status"],
        "properties": {
          "apps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"enum": ["container_audit", "defect_inspection", "inspection_worker", "label_match", "rework_worker"]}
          },
          "reason_code": {"const": "ROLE_PC_SEPARATION_REQUIRED"},
          "shared_resources": {"type": "array", "maxItems": 0},
          "status": {"const": "blocked"}
        }
      }
    },
    "integrated_workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_id", "target_pc", "workflow_mode", "status", "reason_code", "ordered_apps", "shared_resource_ids", "rollback_mode"],
        "properties": {
          "workflow_id": {"const": "test1-five-app-integrated"},
          "target_pc": {"const": "TEST1"},
          "workflow_mode": {"const": "integrated"},
          "status": {"const": "allowed"},
          "reason_code": {"const": "TEST1_INTEGRATED_WORKFLOW_ONLY"},
          "ordered_apps": {
            "type": "array",
            "prefixItems": [
              {"const": "Inspection_worker"},
              {"const": "Rework_worker"},
              {"const": "Defect_Inspection"},
              {"const": "Container_Audit"},
              {"const": "Label_Match"}
            ],
            "items": false,
            "minItems": 5,
            "maxItems": 5
          },
          "shared_resource_ids": {
            "type": "array",
            "prefixItems": [{"const": "inspection-rework-ledger"}],
            "items": false,
            "minItems": 1,
            "maxItems": 1
          },
          "rollback_mode": {"const": "group-deferred"}
        }
      }
    }
  }
}
