{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kmtech.local/factory/v1/deployment-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_schema_version", "policy_version", "entries"],
  "properties": {
    "policy_schema_version": {"const": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["app_id", "contract_bundle_sha256", "status", "not_before", "expires_at", "reason_code"],
        "properties": {
          "app_id": {"type": "string", "minLength": 1}, "contract_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["allowed", "warn-only", "canary-only", "drain-only", "blocked"]}, "not_before": {"type": ["string", "null"], "format": "date-time"}, "expires_at": {"type": ["string", "null"], "format": "date-time"}, "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
        }
      }
    }
  }
}
