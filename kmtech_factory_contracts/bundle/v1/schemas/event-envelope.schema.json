{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kmtech.local/factory/v1/event-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "event_version", "manifest_contract_version", "correlation_id", "idempotency_key", "occurred_at_utc", "aggregate_type", "aggregate_id", "entity_version", "payload_digest", "payload"],
  "properties": {
    "contract_version": {"const": "logistics-v1"},
    "event_version": {"const": "common-event-envelope-v1"},
    "manifest_contract_version": {"const": "producer-onboarding-manifest-v1"},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "occurred_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "aggregate_type": {"type": "string", "minLength": 1},
    "aggregate_id": {"type": "string", "minLength": 1},
    "entity_version": {"type": "integer", "minimum": 0},
    "payload_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload": {"type": "object"}
  }
}
