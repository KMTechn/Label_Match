{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kmtech.local/factory/v1/producer-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_contract_version", "contract_bundle_sha256", "app_id", "producer_id", "producer_install_id", "pc_id", "streams"],
  "properties": {
    "manifest_contract_version": {"const": "producer-onboarding-manifest-v1"},
    "contract_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "app_id": {"type": "string", "minLength": 1},
    "producer_id": {"type": "string", "minLength": 1},
    "producer_install_id": {"type": "string", "minLength": 1},
    "pc_id": {"type": "string", "minLength": 1},
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_id", "source_system", "source_transport", "raw_event_names"],
        "properties": {
          "stream_id": {"type": "string", "minLength": 1},
          "source_system": {"type": "string", "minLength": 1},
          "source_transport": {"type": "string", "minLength": 1},
          "raw_event_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
